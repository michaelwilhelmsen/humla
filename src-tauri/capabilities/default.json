{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "dialog:allow-open",
    "shell:allow-open"
  ]
}
